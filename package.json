{
  "name": "remlux",
  "private": true,
  "version": "0.1.0",
  "description": "Calculate and visualize light spread for groups of downlights in a room.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
